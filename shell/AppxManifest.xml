<?xml version="1.0" encoding="utf-8"?>
<!--
  エクスプローラーの右クリックメニュー用の Sparse パッケージ。
  中身は身元（Identity）とアイコン画像だけで、GitReview.exe と GitReviewShell.dll は
  登録時に指定する外部の場所（%LOCALAPPDATA%\GitReview）に置く。
  そのため GitReview 本体の更新ではこのパッケージを作り直す必要はない。

  ・Publisher は署名する証明書の Subject と完全に一致させる（build-shell.ps1 が差し込む）
  ・CLSID は GitReviewShell.cpp の CLSID_GitReviewCommand と一致させる
  ・ハンドラーやこのファイルを変えたときは Version を上げる
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity Name="GitReview.ContextMenu"
            Publisher="__PUBLISHER__"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>GitReview</DisplayName>
    <PublisherDisplayName>GitReview</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="ja-jp" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="GitReview"
                 Executable="GitReview.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">

      <!-- スタートメニューには出さない（通常のショートカットが別にある） -->
      <uap:VisualElements AppListEntry="none"
                          DisplayName="GitReview"
                          Description="ローカル git のコードレビュー"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- フォルダの右クリックと、フォルダ内の空白の右クリックの両方に出す -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="GitReviewOpen" Clsid="FA52F213-62E8-4BBA-A521-1CAEE25CAE95" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="GitReviewOpen" Clsid="FA52F213-62E8-4BBA-A521-1CAEE25CAE95" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="GitReview context menu">
              <com:Class Id="FA52F213-62E8-4BBA-A521-1CAEE25CAE95"
                         Path="GitReviewShell.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
