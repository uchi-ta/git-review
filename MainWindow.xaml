<Window x:Class="GitReview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:GitReview.Core"
        xmlns:local="clr-namespace:GitReview"
        Title="{Binding TitleText}"
        Width="1360" Height="860" MinWidth="960" MinHeight="600"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Style>
    <Style TargetType="Window">
      <Style.Triggers>
        <!-- git runs out of process; on a large repository the wait is worth showing. -->
        <DataTrigger Binding="{Binding IsBusy}" Value="True">
          <Setter Property="Cursor" Value="Wait"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Style>

  <Window.Resources>

    <!-- ========== commit row ========== -->
    <DataTemplate x:Key="CommitTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"
                     FontSize="13" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock Text="{Binding ShortSha}" FontFamily="{StaticResource MonoFont}"
                       FontSize="11" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="  ·  " Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}"/>
            <TextBlock Text="  ·  " Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>

        <Border x:Name="Badge" Grid.Column="1" Padding="7,2" CornerRadius="4"
                VerticalAlignment="Center" Background="{DynamicResource SurfaceSunken}">
          <TextBlock x:Name="BadgeText" Text="{Binding ProgressText}" FontSize="10.5"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
        </Border>
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsFullyReviewed}" Value="True">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessSoft}"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Success}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ========== branch row (the branch picker) ========== -->
    <DataTemplate x:Key="BranchTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <!-- 今チェックアウトしているブランチに印を付ける -->
          <TextBlock x:Name="Mark" Text="●" FontSize="8" Margin="0,0,6,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Accent}" Visibility="Hidden"/>
          <TextBlock x:Name="NameText" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"
                     FontSize="12.5" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="{Binding ShortSha}" Style="{StaticResource Muted}"
                     FontFamily="{StaticResource MonoFont}" Margin="10,0,8,0"/>
          <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}"/>
        </StackPanel>
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRemote}" Value="True">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ========== file tree row (a folder, or one changed file) ========== -->
    <DataTemplate x:Key="FileTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>   <!-- indent -->
          <ColumnDefinition Width="Auto"/>   <!-- chevron / check -->
          <ColumnDefinition Width="Auto"/>   <!-- type icon -->
          <ColumnDefinition Width="Auto"/>   <!-- status letter -->
          <ColumnDefinition Width="*"/>      <!-- name -->
          <ColumnDefinition Width="Auto"/>   <!-- stats -->
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="{Binding Indent}"/>

        <!-- folders open and close, files carry the review check -->
        <Path x:Name="Chevron" Grid.Column="1" Data="{Binding ChevronGlyph}" Width="15" Height="15"
              Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Visibility="Collapsed"/>
        <CheckBox x:Name="Check" Grid.Column="1" Style="{StaticResource ReviewCheck}"
                  IsChecked="{Binding File.IsReviewed, Mode=TwoWay}" Margin="0,0,7,0"
                  ToolTip="レビュー完了 (Space / ダブルクリック)"/>

        <Path Grid.Column="2" Data="{Binding Glyph}" Width="15" Height="15" Stretch="Uniform"
              VerticalAlignment="Center" Margin="0,0,7,0"
              Stroke="{Binding GlyphBrush}" StrokeThickness="1.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

        <TextBlock x:Name="Status" Grid.Column="3" Text="{Binding File.StatusLetter}"
                   FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>

        <TextBlock x:Name="NameText" Grid.Column="4" Text="{Binding Name}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="7,0,8,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding File.DisplayPath}"/>

        <TextBlock x:Name="Stats" Grid.Column="5" Text="{Binding File.StatText}"
                   Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}"
                   FontSize="11" VerticalAlignment="Center"/>
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsFolder}" Value="True">
          <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Check" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameText" Property="FontFamily" Value="{StaticResource UiFont}"/>
          <Setter TargetName="NameText" Property="FontSize" Value="12"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextMuted}"/>
          <Setter TargetName="Stats" Property="Text" Value="{Binding ProgressText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsFullyReviewed}" Value="True">
          <Setter TargetName="Stats" Property="Foreground" Value="{DynamicResource Success}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding File.IsReviewed}" Value="True">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFaint}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding File.StatusLetter}" Value="A">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource DiffAddMark}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding File.StatusLetter}" Value="D">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource DiffDelMark}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding File.StatusLetter}" Value="R">
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ========== unified diff line ========== -->
    <DataTemplate x:Key="DiffLineTemplate">
      <Border x:Name="Row" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource DiffGutterWidth}"/>
            <ColumnDefinition Width="{DynamicResource DiffGutterWidth}"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource GutterBg}"/>

          <TextBlock Grid.Column="0" Text="{Binding OldNoText}" Margin="0,0,8,0"
                     HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                     FontSize="{DynamicResource DiffGutterFontSize}" Foreground="{DynamicResource GutterText}"/>
          <TextBlock Grid.Column="1" Text="{Binding NewNoText}" Margin="0,0,8,0"
                     HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                     FontSize="{DynamicResource DiffGutterFontSize}" Foreground="{DynamicResource GutterText}"/>

          <Border x:Name="Mark" Grid.Column="2" Background="Transparent"/>

          <TextBlock x:Name="Body" Grid.Column="3" core:DiffText.Segments="{Binding Segments}"
                     Margin="10,0,16,0" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource DiffFontSize}"
                     Foreground="{DynamicResource Text}" TextWrapping="NoWrap"/>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Added">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffAddBg}"/>
          <Setter TargetName="Mark" Property="Background" Value="{DynamicResource DiffAddMark}"/>
          <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource DiffAddText}"/>
          <Setter TargetName="Body" Property="core:DiffText.Highlight" Value="DiffAddWord"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Removed">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffDelBg}"/>
          <Setter TargetName="Mark" Property="Background" Value="{DynamicResource DiffDelMark}"/>
          <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource DiffDelText}"/>
          <Setter TargetName="Body" Property="core:DiffText.Highlight" Value="DiffDelWord"/>
        </DataTrigger>
        <!-- 省略した部分の区切り。色で目立たせず、細い線と控えめな文字で示す -->
        <DataTrigger Binding="{Binding Kind}" Value="Hunk">
          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Border}"/>
          <Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,0"/>
          <Setter TargetName="Row" Property="Padding" Value="0,7,0,4"/>
          <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource TextFaint}"/>
          <Setter TargetName="Body" Property="FontSize" Value="{DynamicResource DiffBannerFontSize}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Meta">
          <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource TextFaint}"/>
          <Setter TargetName="Body" Property="FontStyle" Value="Italic"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Note">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource NoteBg}"/>
          <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource NoteText}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ========== side-by-side row ========== -->
    <!-- Text wraps within each half rather than scrolling: a shared horizontal scrollbar
         would misalign the sides, and clipping would hide content outright. -->
    <DataTemplate x:Key="DiffRowTemplate">
      <Grid>
        <Grid x:Name="Pair">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource DiffGutterWidth}"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="{DynamicResource DiffGutterWidth}"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="{DynamicResource GutterBg}"/>
          <Border x:Name="LeftMark" Grid.Column="1" Background="Transparent"/>
          <Border x:Name="LeftBg" Grid.Column="2" Background="Transparent"/>
          <TextBlock Grid.Column="0" Text="{Binding Left.LineNoText}" Margin="0,0,8,0"
                     HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                     FontSize="{DynamicResource DiffGutterFontSize}" Foreground="{DynamicResource GutterText}"/>
          <TextBlock x:Name="LeftText" Grid.Column="2"
                     core:DiffText.Segments="{Binding Left.Segments}"
                     core:DiffText.Highlight="DiffDelWord"
                     Margin="10,0,10,0" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource DiffFontSize}"
                     Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>

          <Border Grid.Column="3" Background="{DynamicResource Border}"/>

          <Border Grid.Column="4" Background="{DynamicResource GutterBg}"/>
          <Border x:Name="RightMark" Grid.Column="5" Background="Transparent"/>
          <Border x:Name="RightBg" Grid.Column="6" Background="Transparent"/>
          <TextBlock Grid.Column="4" Text="{Binding Right.LineNoText}" Margin="0,0,8,0"
                     HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                     FontSize="{DynamicResource DiffGutterFontSize}" Foreground="{DynamicResource GutterText}"/>
          <TextBlock x:Name="RightText" Grid.Column="6"
                     core:DiffText.Segments="{Binding Right.Segments}"
                     core:DiffText.Highlight="DiffAddWord"
                     Margin="10,0,10,0" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource DiffFontSize}"
                     Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
        </Grid>

        <Border x:Name="BannerBg" Visibility="Collapsed" Background="Transparent">
          <TextBlock x:Name="BannerText" Text="{Binding Banner}" Margin="12,0"
                     FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource DiffBannerFontSize}"
                     Foreground="{DynamicResource TextFaint}" TextWrapping="NoWrap"/>
        </Border>
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Left.Kind}" Value="Removed">
          <Setter TargetName="LeftBg" Property="Background" Value="{DynamicResource DiffDelBg}"/>
          <Setter TargetName="LeftMark" Property="Background" Value="{DynamicResource DiffDelMark}"/>
          <Setter TargetName="LeftText" Property="Foreground" Value="{DynamicResource DiffDelText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Left.Kind}" Value="Empty">
          <Setter TargetName="LeftBg" Property="Background" Value="{DynamicResource DiffEmptyBg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Right.Kind}" Value="Added">
          <Setter TargetName="RightBg" Property="Background" Value="{DynamicResource DiffAddBg}"/>
          <Setter TargetName="RightMark" Property="Background" Value="{DynamicResource DiffAddMark}"/>
          <Setter TargetName="RightText" Property="Foreground" Value="{DynamicResource DiffAddText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Right.Kind}" Value="Empty">
          <Setter TargetName="RightBg" Property="Background" Value="{DynamicResource DiffEmptyBg}"/>
        </DataTrigger>

        <!-- 省略した部分の区切り。1 列表示と同じく控えめに -->
        <DataTrigger Binding="{Binding Kind}" Value="Hunk">
          <Setter TargetName="Pair" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="BannerBg" Property="Visibility" Value="Visible"/>
          <Setter TargetName="BannerBg" Property="BorderBrush" Value="{DynamicResource Border}"/>
          <Setter TargetName="BannerBg" Property="BorderThickness" Value="0,1,0,0"/>
          <Setter TargetName="BannerBg" Property="Padding" Value="0,7,0,4"/>
          <Setter TargetName="BannerText" Property="Foreground" Value="{DynamicResource TextFaint}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Note">
          <Setter TargetName="Pair" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="BannerBg" Property="Visibility" Value="Visible"/>
          <Setter TargetName="BannerBg" Property="Background" Value="{DynamicResource NoteBg}"/>
          <Setter TargetName="BannerText" Property="Foreground" Value="{DynamicResource NoteText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Meta">
          <Setter TargetName="Pair" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="BannerBg" Property="Visibility" Value="Visible"/>
          <Setter TargetName="BannerText" Property="FontStyle" Value="Italic"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <Grid>
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ================= heading ================= -->
      <Grid Grid.Row="0" Margin="2,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding HeadingText}" FontSize="19"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding HeadingSubText}" Style="{StaticResource Muted}"
                   Margin="12,0,12,0" VerticalAlignment="Bottom" Padding="0,0,0,3"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="フォルダを開く" ToolTip="O" Click="OnOpenRepository"/>
          <Button Content="ブランチ" ToolTip="B: ブランチを探して表示を切り替える" Click="OnOpenBranches"/>
          <Button Content="再読込" ToolTip="R / F5" Click="OnReload"/>
          <Button Content="さらに読む" ToolTip="L" Click="OnLoadMore"/>
          <Button x:Name="ThemeButton" Content="テーマ" ToolTip="T" Click="OnToggleTheme"/>
          <Button Content="キー操作" ToolTip="?" Margin="0" Click="OnToggleHelp"/>
        </StackPanel>
      </Grid>

      <!-- ================= command bar ================= -->
      <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}" CornerRadius="8"
              Padding="12,8" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0">
            <TextBlock Text="件名 / 作者 / sha で絞り込み…" IsHitTestVisible="False"
                       VerticalAlignment="Center" FontSize="13.5"
                       Foreground="{DynamicResource TextFaint}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="FilterBox" Style="{StaticResource BareTextBox}"
                     Background="Transparent"
                     Text="{Binding CommitFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     KeyDown="OnFilterBoxKeyDown"/>
          </Grid>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
            <TextBlock Text="rev" Style="{StaticResource Caption}" Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="RevBox" Width="130"
                     Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnRevBoxKeyDown"
                     ToolTip="HEAD / ブランチ名 / --all / A..B など（B でブランチを探す）"/>

            <!-- ブランチを探して選ぶ。リポジトリには触らず、表示する rev を変えるだけ -->
            <!-- 右端に寄っているので、右辺をそろえるように左へずらす（画面から出ないように） -->
            <Popup x:Name="BranchPopup" PlacementTarget="{Binding ElementName=RevBox}"
                   Placement="Bottom" VerticalOffset="6" HorizontalOffset="-290"
                   StaysOpen="False" AllowsTransparency="True" Focusable="False">
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1" CornerRadius="10" Padding="10" Width="420">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="ブランチを絞り込み（↑↓ で選び Enter、Esc で閉じる）"
                             Style="{StaticResource Muted}" Margin="2,0,0,6"/>
                  <TextBox x:Name="BranchSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                           Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"
                           KeyDown="OnBranchSearchKeyDown"
                           TextChanged="OnBranchSearchChanged"/>
                  <ListBox x:Name="BranchList" MaxHeight="320"
                           Style="{StaticResource PlainList}"
                           ItemsSource="{Binding Branches}"
                           ItemTemplate="{StaticResource BranchTemplate}"
                           PreviewMouseLeftButtonUp="OnBranchClicked"/>
                </DockPanel>
              </Border>
            </Popup>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
            <TextBlock Text="件数" Style="{StaticResource Caption}" Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="CountBox" Width="58"
                     Text="{Binding MaxCount, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnRevBoxKeyDown"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= toggles ================= -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
        <CheckBox Style="{StaticResource PillToggle}" Content="未レビューのコミットのみ"
                  ToolTip="Shift+U"
                  IsChecked="{Binding UnreviewedCommitsOnly, Mode=TwoWay}"/>
        <CheckBox Style="{StaticResource PillToggle}" Content="未レビューのファイルのみ"
                  ToolTip="U"
                  IsChecked="{Binding UnreviewedFilesOnly, Mode=TwoWay}"/>
        <CheckBox Style="{StaticResource PillToggle}" Content="空白の変更を無視"
                  ToolTip="W"
                  IsChecked="{Binding IgnoreWhitespace, Mode=TwoWay}"/>
        <CheckBox Style="{StaticResource PillToggle}" Content="変更箇所だけ"
                  ToolTip="C: 変更のない行を省略する（既定はファイル全体）"
                  IsChecked="{Binding AbbreviateContext, Mode=TwoWay}"/>
        <CheckBox x:Name="SplitToggle" Style="{StaticResource PillToggle}"
                  Content="左右に並べる" ToolTip="S"
                  IsChecked="{Binding SplitView, Mode=TwoWay}"
                  Checked="OnSplitViewChanged" Unchecked="OnSplitViewChanged"/>
        <TextBlock Text="{Binding DiffOptionText}" Style="{StaticResource Muted}"
                   VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="C で切替"/>
      </StackPanel>

      <!-- ================= main ================= -->
      <Grid x:Name="MainSplit" Grid.Row="3" SizeChanged="OnMainSplitSizeChanged">
        <Grid.ColumnDefinitions>
          <!-- 幅は拡大率に合わせてコード側で決める（OnLoaded / SetZoom） -->
          <ColumnDefinition x:Name="LeftColumn" Width="430" MinWidth="280"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftRows" Grid.Column="0">
          <Grid.RowDefinitions>
            <!-- 高さの割合はコード側で決める（OnLoaded / 仕切りのドラッグ） -->
            <RowDefinition x:Name="CommitRow" Height="*" MinHeight="120"/>
            <RowDefinition Height="8"/>
            <RowDefinition x:Name="FileRow" Height="1.15*" MinHeight="120"/>
          </Grid.RowDefinitions>

          <Border x:Name="CommitPane" Grid.Row="0" Style="{StaticResource Pane}">
            <Border Style="{StaticResource PaneBody}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,9,10,4">
                  <TextBlock Text="コミット履歴" Style="{StaticResource Caption}"/>
                  <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}"
                             FontSize="11"
                             Text="{Binding Commits.Count, StringFormat={}{0} 件}"/>
                </Grid>
                <ListBox x:Name="CommitList" Style="{StaticResource PlainList}"
                         ItemsSource="{Binding Commits}"
                         ItemTemplate="{StaticResource CommitTemplate}"
                         SelectionMode="Extended"
                         SelectionChanged="OnCommitSelectionChanged"
                         GotKeyboardFocus="OnPaneFocused">
                  <!-- Ctrl+ホイールの倍率。幅は倍率の分だけ狭く測られるので、見た目はペインに収まる -->
                  <ListBox.LayoutTransform>
                    <ScaleTransform ScaleX="{DynamicResource ListZoom}" ScaleY="{DynamicResource ListZoom}"/>
                  </ListBox.LayoutTransform>
                </ListBox>
              </DockPanel>
            </Border>
          </Border>

          <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                        ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

          <Border x:Name="FilePane" Grid.Row="2" Style="{StaticResource Pane}">
            <Border Style="{StaticResource PaneBody}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,9,10,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="変更ファイル" Style="{StaticResource Caption}"/>
                  <ProgressBar Grid.Column="1" Style="{StaticResource SlimProgress}"
                               Margin="12,0,12,0" Maximum="1"
                               Value="{Binding ProgressRatio, Mode=OneWay}"
                               VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding ProgressText}"
                             Style="{StaticResource Muted}" FontSize="11"/>
                </Grid>
                <ListBox x:Name="FileList" Style="{StaticResource PlainList}"
                         ItemsSource="{Binding Files}"
                         ItemTemplate="{StaticResource FileTemplate}"
                         SelectionMode="Single"
                         SelectionChanged="OnFileSelectionChanged"
                         MouseDoubleClick="OnFileDoubleClick"
                         GotKeyboardFocus="OnPaneFocused">
                  <ListBox.LayoutTransform>
                    <ScaleTransform ScaleX="{DynamicResource ListZoom}" ScaleY="{DynamicResource ListZoom}"/>
                  </ListBox.LayoutTransform>
                </ListBox>
              </DockPanel>
            </Border>
          </Border>
        </Grid>

        <!-- 既定のままだと左右の列ではなく仕切り自身の列が太るので、動かす対象を明示する -->
        <GridSplitter Grid.Column="1" Width="8" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

        <Border x:Name="DiffPane" Grid.Column="2" Style="{StaticResource Pane}">
          <Border Style="{StaticResource PaneBody}" ClipToBounds="True">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="14,10,12,9"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DiffHeader}" FontFamily="{StaticResource MonoFont}"
                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DiffSubHeader}" Style="{StaticResource Muted}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="TextModeButton" Style="{StaticResource PillToggle}"
                              Content="テキスト" Focusable="False" Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="V: 文字を選んでコピーできる表示に切り替え"
                              Checked="OnTextModeChanged" Unchecked="OnTextModeChanged"/>

                    <!-- GitHub の Files タブの Viewed と同じ役割。押すと次のファイルへ進む。
                         Focusable=False にして、押してもキーボードの位置を一覧から奪わない -->
                    <Button x:Name="ViewedButton" Style="{StaticResource ViewedButton}"
                            Focusable="False" Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="OnViewedClick"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- ファイルを切り替えたときは、この枠ごと軽く浮かせて出す（MainWindow.xaml.cs） -->
              <Grid x:Name="DiffContent" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="DiffList" Grid.Column="0"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemsSource="{Binding DiffLines}"
                         ItemTemplate="{StaticResource DiffLineTemplate}"
                         ItemContainerStyle="{StaticResource DiffRowContainer}"
                         SelectionMode="Extended"
                         GotKeyboardFocus="OnPaneFocused"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"/>

                <ListBox x:Name="SplitList" Visibility="Collapsed" Grid.Column="0"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemsSource="{Binding DiffRows}"
                         ItemTemplate="{StaticResource DiffRowTemplate}"
                         ItemContainerStyle="{StaticResource DiffRowContainer}"
                         SelectionMode="Extended"
                         GotKeyboardFocus="OnPaneFocused"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"/>

                <!-- 文字単位で選んでコピーするための表示。色は付かないが、範囲選択と Ctrl+C が
                     そのまま使える（一覧の行は文字単位では選べないため） -->
                <!-- コードの縮小イメージつきのスクロールバー。一覧の標準のものはこれに置き換える -->
                <local:DiffOverview x:Name="DiffMap" Grid.Column="1" Width="110"
                                    ToolTip="ファイル全体の縮小イメージ。押すとその場所へ飛ぶ"/>

                <TextBox x:Name="DiffTextBox" Visibility="Collapsed" Grid.Column="0"
                         Style="{StaticResource DiffTextArea}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True" IsUndoEnabled="False"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="{DynamicResource DiffFontSize}"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- 行き止まりの合図。短く光って消えるだけで、操作は妨げない -->
                <Grid x:Name="DiffHint" Grid.Column="0" Opacity="0" IsHitTestVisible="False">
                  <Border x:Name="DiffHintEdge" Height="3" VerticalAlignment="Bottom">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>

                  <!-- 見落とさない程度に、アクセント色の縁と影で浮かせる。色で驚かせはしない -->
                  <Border x:Name="DiffHintPill" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                          Margin="0,0,0,18" CornerRadius="14" Padding="14,7,16,7"
                          Background="{DynamicResource AccentQuiet}"
                          BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                    <Border.RenderTransform>
                      <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                        Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="DiffHintIcon" Margin="0,0,8,0" VerticalAlignment="Center"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Accent}"/>
                      <TextBlock x:Name="DiffHintText" VerticalAlignment="Center"
                                 FontSize="12.5" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </DockPanel>
          </Border>
        </Border>
      </Grid>

      <!-- ================= status ================= -->
      <Grid Grid.Row="4" Margin="2,10,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <!-- 今いるペインでよく使うキーを出す。押すと一覧（? と同じ）が開く -->
        <TextBlock x:Name="KeyHints" Grid.Column="1" Style="{StaticResource Muted}"
                   VerticalAlignment="Center" Cursor="Hand"
                   ToolTip="? でキー操作の一覧"
                   MouseLeftButtonUp="OnToggleHelp"/>
      </Grid>
    </Grid>

    <!-- ================= help overlay ================= -->
    <Border x:Name="HelpOverlay" Visibility="Collapsed" Background="#A6000000"
            MouseLeftButtonDown="OnToggleHelp">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="12" Padding="28,24"
              HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1120">
        <StackPanel>
          <TextBlock Text="キー操作" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="36"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="HelpLeft" Grid.Column="0"/>
            <StackPanel x:Name="HelpRight" Grid.Column="2"/>
          </Grid>
          <TextBlock Text="Esc または ? で閉じる" Style="{StaticResource Muted}"
                     Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
